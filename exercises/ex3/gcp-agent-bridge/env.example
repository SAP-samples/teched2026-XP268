# ─────────────────────────────────────────────────────────────────────────────
# gcp-agent-bridge configuration
#
# Copy this file to `.env` (`cp env.example .env`) and fill in every
# <PLACEHOLDER>. See README.md for what each value is and how to obtain it.
# `.env` is gitignored; this template is safe to commit.
# ─────────────────────────────────────────────────────────────────────────────

# Gemini model the proxy agent runs on.
MODEL=gemini-3.8-flash

# Name the ADK agent reports on its A2A card and as telemetry gen_ai.agent.name.
# Must be a valid identifier (letters, digits, underscores; not starting with a
# digit). When you change this, also update `root_agent_name:` in
# agents-cli-manifest.yaml so telemetry/trace selection stays consistent.
AGENT_NAME=proxy_agent

# A2A (JSON-RPC) endpoint of the downstream agent every request is forwarded to.
# e.g. https://my-downstream-host/a2a/my-agent
DOWNSTREAM_AGENT_URL=<YOUR_DOWNSTREAM_AGENT_A2A_URL>

# client_id of the application registered at your IdP. Used as `client_id` in
# the token exchange.
OAUTH_CLIENT_ID=<YOUR_IDP_APPLICATION_CLIENT_ID>

# client_secret of the application registered at your IdP. Authenticates the
# client leg of the token exchange.
OAUTH_CLIENT_SECRET=<YOUR_IDP_APPLICATION_CLIENT_SECRET>

# Base URL of your IdP. The token endpoint is <host>/oauth2/token.
# e.g. https://your-tenant.accounts.ondemand.com
OAUTH_TOKEN_HOST=<YOUR_IDP_BASE_URL>

# The resource / audience the exchanged token should be scoped to (identifies
# the downstream resource to the IdP).
TOKEN_EXCHANGE_RESOURCE=<YOUR_DOWNSTREAM_RESOURCE_URN_OR_AUDIENCE>